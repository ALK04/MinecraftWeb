{
  "name": "minecraft-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n site,api -c green,blue \"vite\" \"npm:dev:api\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
