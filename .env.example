# Copie ce fichier en .env pour le développement local
PORT=3000
# Dossier de données du serveur Minecraft (contient usercache.json et <monde>/stats)
MC_DATA=./mc-test
MC_MONDE=world
# BlueMap (pour savoir qui est connecté)
BLUEMAP_URL=http://localhost:8099
# Base de données des objectifs
DB_PATH=./data/objectifs.db
# Code à donner aux potes pour écrire sur le tableau des objectifs (vide = ouvert à tous)
CODE_OBJECTIFS=
